{
  "expo": {
    "name": "Forma",
    "slug": "forma",
    "scheme": "forma",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#192C29",
          "dark": {
            "backgroundColor": "#192C29"
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.forma.fitness"
    },
    "android": {
      "package": "app.forma.fitness"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "backgroundColor": "#192C29"
  }
}
